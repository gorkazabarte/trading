# IBKR Connection Configuration
# Choose between TWS (Trader Workstation) or IB Gateway

# Set to 'true' to use TWS, 'false' to use IB Gateway
IB_USE_TWS=false

# Optional: Override port (leave commented to use defaults)
# TWS default: 7497 (live) or 7497 (paper)
# Gateway default: 4001 (live) or 4002 (paper)
# IB_PORT=7496

# Optional: Override host (default: 127.0.0.1)
# IB_HOST=127.0.0.1

# Optional: Client ID (default: 1)
# IB_CLIENT_ID=1
